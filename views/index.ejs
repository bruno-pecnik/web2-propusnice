<!DOCTYPE html>
<html lang="hr">
<head>
    <meta charset="UTF-8">
    <title>Sustav propusnica</title>
</head>
<body>
    <h1>Sustav propusnica</h1>

    <table border="1">
        <tr>
            <th>Ukupno</th>
            <th>Aktivne</th>
        </tr>
        <tr>
            <td><%= total %></td>
            <td><%= active %></td>
        </tr>
    </table>
    <% if (email) { %>
        <p>Prijavljeni ste kao <%= email %></p>
        <form action="/logout" method="post">
            <button type="submit">Odjavi se</button>
        </form>
    <% } else { %>
        <p><a href="/login">Prijavi se</a></p>
    <% } %>
</body>
</html>
